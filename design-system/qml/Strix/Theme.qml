    readonly property int dockRest: 5  // Height of the dock at rest: a thin tab on the bottom edge.
    readonly property int dockHeight: 32  // Height of the dock once the pointer reaches the bottom edge.
    readonly property int osdHeight: 32  // Height of the OSD.

    // ------------------------------------------------------------ motion
    /// True when the person asked for less motion; every duration but the theme cycle becomes 1 ms.
    property bool reducedMotion: false
    readonly property int durInstant: reducedMotion ? 1 : 80  // Press feedback, menu hover.
    readonly property int durFast: reducedMotion ? 1 : 140  // Hover, focus, tooltips, small fades, border colour.
    readonly property int durBase: reducedMotion ? 1 : 220  // Switch, segmented thumb, tab change, dialogs, list items entering.
    readonly property int durSlow: reducedMotion ? 1 : 360  // Panel growing out of the pill, carousel, windows opening and moving, window focus, workspace change, rolling numbers.
    readonly property int durReveal: reducedMotion ? 1 : 640  // Circular reveal of a new theme, unlocking, ring gauges filling.
    readonly property int durLoop: reducedMotion ? 1 : 1400  // One pass of an indeterminate progress line.
    readonly property int themeCycle: 600000  // How often the theme of the desktop changes by itself to another god, unless kept in the theme picker.
    readonly property int stagger: reducedMotion ? 1 : 30  // Delay between neighbours when a list enters.
