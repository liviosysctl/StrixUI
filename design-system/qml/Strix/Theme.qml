    readonly property var easeOut: [0.2, 0.8, 0.2, 1, 1, 1]  // Things arriving: open, enter, hover.
    readonly property var easeIn: [0.5, 0, 0.9, 0.3, 1, 1]  // Things leaving: close, dismiss.
