    readonly property color termBrightCyan: css(tc["bright-cyan"])
    readonly property color termBrightWhite: css(tc["bright-white"])

    // ------------------------------------------------------------ sizes in pixels at scale 1
    readonly property int space1: 4  // Gap between an icon and its value; padding inside the pill.
    readonly property int space2: 8  // Gap between related controls; gap from pill to panel.
    readonly property int space3: 12  // Padding of buttons and segments. Gap between tiled windows.
    readonly property int space4: 16  // Padding of panels, cards and windows. Side inset of the top bar.
    readonly property int space5: 24  // Padding of dialogs; gap between groups.
    readonly property int space6: 32  // Gap between sections.
    readonly property int space7: 48  // Outer margin of full-screen layouts.
    readonly property int space8: 64  // Left inset of the lock screen column.
