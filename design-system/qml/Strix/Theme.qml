    function apply(tokens) {
        if (!tokens || !tokens.colors) return
        if (tokens.theme && themes[tokens.theme]) current = tokens.theme
        const base = themes[current] || themes["saturnus"]
        const merged = Object.assign({}, base)
        for (const k in tokens.colors) if (k in base) merged[k] = tokens.colors[k]
        live = merged
        const t = tokens.terminal
        if (t) {
            const term = Object.assign({}, terminals[current] || terminals["saturnus"])
            for (const k of ["background", "foreground", "cursor", "selection"]) if (t[k]) term[k] = t[k]
            const names = ["black", "red", "green", "yellow", "blue", "magenta", "cyan", "white", "bright-black", "bright-red", "bright-green", "bright-yellow", "bright-blue", "bright-magenta", "bright-cyan", "bright-white"]
            if (t.palette) for (let i = 0; i < names.length && i < t.palette.length; i++) term[names[i]] = t.palette[i]
            liveTerminal = term
        }
    }

    /// Back to the built-in theme of `id` (or of `current`).
    function preview(id) {
