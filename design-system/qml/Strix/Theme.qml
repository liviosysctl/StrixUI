// Every token of the Strix design system. Generated by strixui build from tokens.json. Do not edit.
//
// The colours follow the theme engine at runtime: Strix.Shell's ThemeFile reads
// /run/strix/theme/tokens.json and calls apply(). Without it (a gallery, a test) the
// built-in themes below are used, picked by `current`.
pragma Singleton
import QtQuick

QtObject {
    id: theme

    // ------------------------------------------------------------ which theme
    /// Id of the theme in use. Set it to preview a god; apply() sets it from the engine.
    property string current: "saturnus"
    /// Variant of the theme in use: dark or light. apply() sets it from the engine.
    property string variant: "dark"
    /// Ids in the order of the theme picker, the default first.
    readonly property var order: ["saturnus", "janus", "apollo", "mars", "vulcanus", "neptunus", "pluto", "bacchus"]
    /// Name, description, wallpaper file and plate caption of every theme.
    readonly property var gods: ({
        saturnus: { name: "Saturnus", description: "Strix red. Saturn, lord of time and of the night hours; the default.", wallpaper: "saturnus.jpg", plate: "Saturnus devours one of his children, his scythe beside him in the niche. Jacob Binck after Rosso Fiorentino, 1530" },
        janus: { name: "Janus", description: "Patina, the green of old bronze doors and keys.", wallpaper: "janus.jpg", plate: "Janus with both faces opens the door of the year. Engraved by Robert van Audenaerd after Carlo Maratta" },
        apollo: { name: "Apollo", description: "Antique gold, worn brass.", wallpaper: "apollo.jpg", plate: "Apollo with his laurel wreath on the chariot of the sun, in his niche. Jacob Binck after Rosso Fiorentino" },
        mars: { name: "Mars", description: "Rust, iron and burnt sienna.", wallpaper: "mars.jpg", plate: "Mars with helmet, shield and sword, seen from behind in his niche. Jacob Binck after Rosso Fiorentino, 1530" },
        vulcanus: { name: "Vulcanus", description: "Olive, the patina on old bronze from the forge.", wallpaper: "vulcanus.jpg", plate: "Vulcanus swings his hammers over the anvil in his niche. Jacob Binck after Rosso Fiorentino, 1530" },
        neptunus: { name: "Neptunus", description: "Deep water, slate and ink blue.", wallpaper: "neptunus.jpg", plate: "Neptunus with trident and hippocamp in his niche. Jacob Binck after Rosso Fiorentino, 1530" },
        pluto: { name: "Pluto", description: "Heather, faded plum.", wallpaper: "pluto.jpg", plate: "Pluto with his two-pronged fork and Cerberus in his niche. Jacob Binck after Rosso Fiorentino, 1530" },
        bacchus: { name: "Bacchus", description: "Claret, old wine.", wallpaper: "bacchus.jpg", plate: "Bacchus with drinking bowl and vines, a small satyr at his feet, in his niche. Jacob Binck after Rosso Fiorentino, 1530" }
    })
    /// Folder of the wallpapers, with a trailing slash. The shell may point it elsewhere.
    property url wallpapers: Qt.resolvedUrl("../../assets/Wallpapers/")
    /// A theme from a connected theme repository: id, name, description, dir (its folder), plate. Set by apply().
    property var external: null
    /// Name, description and plate of the theme in use, built in or external.
    readonly property var about: gods[current] || (external && external.id === current ? external : gods["saturnus"])
    function wallpaper(id) {
        id = id || current
        // Every god has two plates: the dark one and, for the light variant, <god>-light.jpg
        if (gods[id]) return wallpapers + (variant === "light" ? gods[id].wallpaper.replace(".jpg", "-light.jpg") : gods[id].wallpaper)
        if (external && external.id === id) return "file://" + external.dir + "/wallpaper.jpg"
        return wallpapers + gods["saturnus"].wallpaper
    }

    /// Colours read from the engine's tokens.json; empty until apply() ran.
    property var live: null
    property var liveTerminal: null

    /// Takes the engine's tokens.json (already parsed). Unknown or missing colours fall back to the built-in theme.
    function apply(tokens) {
        if (!tokens || !tokens.colors) return
        if (tokens.theme && !themes[tokens.theme])
            external = { id: tokens.theme, name: tokens.name || tokens.theme, description: tokens.description || "", dir: tokens.dir || "", plate: tokens.plate || "", wallpaper: "wallpaper.jpg" }
        if (tokens.theme) current = tokens.theme
        if (tokens.variant) variant = tokens.variant
        const base = themes[current] || themes["saturnus"]
        const merged = Object.assign({}, base)
        for (const k in tokens.colors) if (k in base) merged[k] = tokens.colors[k]
        live = merged
        const t = tokens.terminal
        if (t) {
            const term = Object.assign({}, terminals[current] || terminals["saturnus"])
            for (const k of ["background", "foreground", "cursor", "selection"]) if (t[k]) term[k] = t[k]
            const names = ["black", "red", "green", "yellow", "blue", "magenta", "cyan", "white", "bright-black", "bright-red", "bright-green", "bright-yellow", "bright-blue", "bright-magenta", "bright-cyan", "bright-white"]
            if (t.palette) for (let i = 0; i < names.length && i < t.palette.length; i++) term[names[i]] = t.palette[i]
            liveTerminal = term
        }
    }

    /// Back to the built-in theme of `id` (or of `current`).
    function preview(id) {
        live = null
        liveTerminal = null
        if (id) current = id
    }

    /// a mixed with b: t = 0 gives a, t = 1 gives b (CSS color-mix in srgb)
    function mix(a, b, t) { return Qt.rgba(a.r + (b.r - a.r) * t, a.g + (b.g - a.g) * t, a.b + (b.b - a.b) * t, a.a + (b.a - a.a) * t) }
    /// The colour with another opacity.
    function alpha(c, a) { return Qt.rgba(c.r, c.g, c.b, a) }
    /// A colour of the tokens as QML reads it: CSS writes the opacity last (#rrggbbaa), QML first
    /// (#aarrggbb), so the scrim would turn into a clear blue.
    function css(v) { return typeof v === "string" && v.length === 9 ? "#" + v.slice(7) + v.slice(1, 7) : v }

    readonly property var c: live || themes[current] || themes["saturnus"]
    readonly property var tc: liveTerminal || terminals[current] || terminals["saturnus"]

